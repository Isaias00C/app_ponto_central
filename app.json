{
  "expo": {
    "name": "Ponto Central",
    "slug": "app_ponto_central",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pontocentral.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pontocentral.app"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Ponto Central",
      "shortName": "PontoCentral",
      "description": "Estoque de camisas do Ponto Central",
      "lang": "pt-BR",
      "display": "standalone",
      "themeColor": "#1D4ED8",
      "backgroundColor": "#F4F5F7"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para você escolher a imagem da camisa.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "pontocentral",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app_ponto_central"
    }
  }
}
